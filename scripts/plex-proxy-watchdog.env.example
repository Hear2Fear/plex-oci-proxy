# Copy to ~/.plex-proxy-watchdog.env and chmod 600.

PLEX_URL=plex.example.com
CERT_WARN_DAYS=14
FAIL_THRESHOLD=2
REPEAT_SEC=21600

# Optional: check the VM's tailnet peer. Leave TS_PEER empty to skip.
TS_PEER=plex-proxy
# Synology DSM:  TAILSCALE_BIN=/var/packages/Tailscale/target/bin/tailscale
TAILSCALE_BIN=tailscale

# Any command taking two arguments: "<subject>" "<body>". Examples are in
# scripts/notify-examples.sh. Pick one and point NOTIFY_CMD at it.
NOTIFY_CMD="$HOME/bin/notify.sh"
